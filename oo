
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>数学</title>

<script src="https://cdn.jsdelivr.net/npm/nerdamer@2.0.1/dist/bundle.js"></script>

<style>
* { box-sizing: border-box; }

body {
  font-family: "Yu Mincho", "游明朝", serif;
  background: #e9ecef;
  margin: 0;
  padding: 30px 12px;
  color: #222;
}

.paper {
  max-width: 800px;
  margin: auto;
  background: #fff;
  padding: 40px 50px;
  box-shadow: 0 0 10px rgba(0,0,0,0.15);
}

h1 {
  text-align: center;
  letter-spacing: 5px;
  margin: 0 0 35px;
  font-size: 28px;
}

.info {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 30px;
}

.info-item {
  width: 50%;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #222;
  padding-bottom: 6px;
}

.info-item input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  font-family: inherit;
  font-size: 17px;
  padding: 3px 5px;
}

/* 注意事項 */
.notice {
  border: 1px solid #999;
  padding: 15px 20px;
  margin-bottom: 30px;
  background: #fafafa;
}

.notice-title {
  font-weight: bold;
  font-size: 17px;
  margin-bottom: 8px;
}

.notice-content {
  font-size: 14px;
  line-height: 1.8;
}

.section { margin-top: 30px; }

.section-title {
  font-weight: bold;
  font-size: 19px;
  border-bottom: 1px solid #999;
  padding-bottom: 6px;
  margin-bottom: 15px;
}

.question {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 14px 0;
  min-height: 38px;
}

.label {
  width: 90px;
  flex-shrink: 0;
  font-size: 17px;
}

.answer-input {
  width: 100%;
  max-width: 400px;
  min-width: 0;
  border: none;
  border-bottom: 2px solid #222;
  border-radius: 0;
  outline: none;
  font-family: "Times New Roman", "Yu Mincho", serif;
  font-size: 18px;
  padding: 5px 8px;
  text-align: center;
  background: transparent;
}

.answer-input:focus {
  border-bottom: 2px solid #2878c8;
}

.result {
  width: 35px;
  flex-shrink: 0;
  font-size: 19px;
  font-weight: bold;
  text-align: center;
}

.not-graded {
  color: #888;
  font-size: 13px;
  font-weight: normal;
  width: auto;
}

.score {
  text-align: right;
  font-size: 21px;
  font-weight: bold;
  margin-top: 30px;
  padding-top: 15px;
  border-top: 2px solid #222;
}

.score-note {
  text-align: right;
  color: #666;
  font-size: 13px;
  margin-top: 5px;
}

.comment-area { margin-top: 25px; }

.comment-area label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
}

.comment-area textarea {
  width: 100%;
  min-height: 75px;
  resize: vertical;
  font-family: inherit;
  font-size: 15px;
  padding: 8px;
  border: 1px solid #aaa;
}

.buttons {
  text-align: center;
  margin-top: 30px;
}

button {
  padding: 12px 32px;
  margin: 5px 8px;
  font-family: inherit;
  font-size: 17px;
  cursor: pointer;
  border: 1px solid #555;
  background: #f7f7f7;
  border-radius: 3px;
}

button:hover { background: #e5e5e5; }

button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

#sendStatus {
  text-align: center;
  margin-top: 15px;
  font-size: 14px;
}

@media (max-width: 600px) {
  body { padding: 10px 5px; }

  .paper { padding: 25px 18px; }

  h1 {
    font-size: 23px;
    letter-spacing: 3px;
  }

  .info { gap: 12px; }

  .info-item { font-size: 14px; }

  .label {
    width: 75px;
    font-size: 15px;
  }

  .answer-input { font-size: 16px; }

  .question { gap: 5px; }
}

@media print {
  body {
    background: #fff;
    padding: 0;
  }

  .paper {
    box-shadow: none;
    max-width: none;
    padding: 20px;
  }

  button,
  #sendStatus,
  .comment-area {
    display: none;
  }

  .answer-input {
    border-bottom: 1px solid #222;
  }
}
</style>
</head>

<body>

<div class="paper">

  <h1>数 学</h1>

  <div class="info">
    <div class="info-item">
      氏名：
      <input type="text" id="studentName" autocomplete="name">
    </div>

    <div class="info-item">
      得点：
      <span id="topScore"></span>
    </div>
  </div>

  <!-- =====================================
       回答上の注意事項
       ここを書き換えてください
       ===================================== -->
  <div class="notice">
    <div class="notice-title">解答上の注意事項</div>

    <div class="notice-content">
      <ul>
        <li>氏名を必ず入力してください。</li>
        <li>解答は指定された欄に入力してください。</li>
        <li>分数は「1/2」、平方根は「√2」のように入力してください。</li>
        <li>解答を入力したら「採点して回答を送信」を押してください。</li>
        <li>送信後は、回答を変更して再送信しないようにしてください。</li>
      </ul>
    </div>
  </div>

  <!-- 大問1 -->
  <div class="section">
    <div class="section-title">大問1</div>

    <div class="question">
      <div class="label">(1)</div>
      <input class="answer-input" id="q1_1">
      <span class="result" id="r_q1_1"></span>
    </div>

    <div class="question">
      <div class="label">(2)</div>
      <input class="answer-input" id="q1_2">
      <span class="result" id="r_q1_2"></span>
    </div>

    <div class="question">
      <div class="label">(3)</div>
      <input class="answer-input" id="q1_3">
      <span class="result" id="r_q1_3"></span>
    </div>

    <div class="question">
      <div class="label">(4)</div>
      <input class="answer-input" id="q1_4">
      <span class="result" id="r_q1_4"></span>
    </div>
  </div>

  <!-- 大問2 -->
  <div class="section">
    <div class="section-title">大問2</div>

    <div class="question">
      <div class="label">解答</div>
      <input class="answer-input" id="q2">
      <span class="result" id="r_q2"></span>
    </div>
  </div>

  <!-- 大問3 -->
  <div class="section">
    <div class="section-title">大問3</div>

    <div class="question">
      <div class="label">(1)</div>
      <input class="answer-input" id="q3_1">
      <span class="result" id="r_q3_1"></span>
    </div>

    <div class="question">
      <div class="label">(2)</div>
      <input class="answer-input" id="q3_2">
      <span class="result" id="r_q3_2"></span>
    </div>
  </div>

  <!-- 大問4 -->
  <div class="section">
    <div class="section-title">大問4</div>

    <div class="question">
      <div class="label">(1) x</div>
      <input class="answer-input" id="q4_1_x" placeholder="x の式">
      <span class="result" id="r_q4_1_x"></span>
    </div>

    <div class="question">
      <div class="label">(1) y</div>
      <input class="answer-input" id="q4_1_y" placeholder="y の式">
      <span class="result" id="r_q4_1_y"></span>
    </div>

    <div class="question">
      <div class="label">(2)</div>
      <input class="answer-input" id="q4_2">
      <span class="result" id="r_q4_2"></span>
    </div>
  </div>

  <!-- 大問5 -->
  <div class="section">
    <div class="section-title">大問5</div>

    <div class="question">
      <div class="label">(1)(i)</div>
      <input class="answer-input" id="q5_1_i">
      <span class="result" id="r_q5_1_i"></span>
    </div>

    <div class="question">
      <div class="label">(1)(ii)</div>
      <input class="answer-input" id="q5_1_ii">
      <span class="result" id="r_q5_1_ii"></span>
    </div>

    <div class="question">
      <div class="label">(2)</div>
      <input class="answer-input" id="q5_2">
      <span class="result" id="r_q5_2"></span>
    </div>
  </div>

  <div class="comment-area">
    <label for="comment">コメント（任意）</label>
    <textarea id="comment"
      placeholder="質問やコメントがあれば入力してください。"></textarea>
  </div>

  <div class="buttons">
    <button type="button" onclick="gradeAndSend()" id="sendButton">
      採点して回答を送信
    </button>

    <button type="button" onclick="resetAll()">リセット</button>
  </div>

  <div class="score" id="score"></div>
  <div class="score-note">※大問4 (1) は x・y の両方が正解した場合のみ10点です。</div>
  <div id="sendStatus"></div>

</div>

<script>

// ==========================================
// Google Apps ScriptのURL
// ==========================================
const GAS_URL = "https://script.google.com/macros/s/AKfycby-C_hc1WDQAzpdMBBR5CYi0mHK3-jTL2IFP_Z4lYDQhlQMH6SwHUMJa270wDpsGYD3vg/exec";


// ==========================================
// 模範解答
// ==========================================
const answers = {
  q1_1: { accepted: ["1"], points: 10 },
  q1_2: { accepted: ["10π^2"], points: 10 },
  q1_3: { accepted: ["8"], points: 10 },
  q1_4: { accepted: ["π"], points: 10 },

  q2: { accepted: ["√2-1"], points: 10 },

  q3_1: { accepted: ["27/2"], points: 10 },
  q3_2: { accepted: ["(81k+27)/8"], points: 10 },

  q4_2: {
    accepted: ["-sqrt(r^2-4)-asin(2/r)"],
    points: 10
  },

  q5_1_i: { accepted: ["16/9"], points: 10 },

  q5_1_ii: {
    accepted: ["(450π/9)-(192/7)"],
    points: 10
  },

  q5_2: { accepted: ["2,3"], points: 10 }
};

const allQuestionIds = [
  "q1_1", "q1_2", "q1_3", "q1_4",
  "q2",
  "q3_1", "q3_2",
  "q4_1_x", "q4_1_y", "q4_2",
  "q5_1_i", "q5_1_ii", "q5_2"
];

const totalPoints = 120;


// ==========================================
// 数式の表記を統一
// ==========================================
function normalizeMath(value) {
  return value
    .trim()
    .normalize("NFKC")
    .replace(/\s+/g, "")
    .replace(/−/g, "-")
    .replace(/ー/g, "-")
    .replace(/×/g, "*")
    .replace(/·/g, "*")
    .replace(/÷/g, "/")
    .replace(/π/g, "pi")
    // tcost, tsint, cost, sint の省略表記に対応
    .replace(/tcost/g, "t*cos(t)")
    .replace(/tsint/g, "t*sin(t)")
    .replace(/cost/g, "cos(t)")
    .replace(/sint/g, "sin(t)")
    // sin^(-1)(...) を逆正弦関数 asin(...) に変換
    .replace(/sin\^\(-1\)\s*\(/g, "asin(")
    .replace(/√\s*\(/g, "sqrt(")
    .replace(/√\s*([0-9]+)/g, "sqrt($1)")
    .toLowerCase();
}


// ==========================================
// 許可する数式の文字を確認
// ==========================================
function isAllowedExpression(expression) {
  if (!expression) return false;

  return /^[0-9a-z+\-*/^().]+$/i.test(expression);
}


// ==========================================
// 数学的な同値判定
// ==========================================
function mathEquivalent(userAnswer, correctAnswer) {
  try {
    const user = normalizeMath(userAnswer);
    const correct = normalizeMath(correctAnswer);

    if (!user || !correct) return false;

    if (
      !isAllowedExpression(user) ||
      !isAllowedExpression(correct)
    ) {
      return false;
    }

    if (typeof nerdamer !== "function") {
      throw new Error("数式処理ライブラリが読み込まれていません。");
    }

    return nerdamer(user).eq(nerdamer(correct));

  } catch (error) {
    console.warn("数式判定エラー:", error);
    return false;
  }
}


// ==========================================
// 正誤判定
// ==========================================
function isCorrectAnswer(userAnswer, acceptedAnswers, questionId) {
  const user = userAnswer.trim();

  if (!user) return false;

  // 大問5 (2)：2つの数値の順番を問わない
  if (questionId === "q5_2") {
    const userParts = user.split(",");

    if (userParts.length !== 2) return false;

    const correctParts = acceptedAnswers[0].split(",");

    return (
      (
        mathEquivalent(userParts[0], correctParts[0]) &&
        mathEquivalent(userParts[1], correctParts[1])
      ) ||
      (
        mathEquivalent(userParts[0], correctParts[1]) &&
        mathEquivalent(userParts[1], correctParts[0])
      )
    );
  }

  return acceptedAnswers.some(correct =>
    mathEquivalent(user, correct)
  );
}


// ==========================================
// 採点
// ==========================================
function grade() {
  if (typeof nerdamer !== "function") {
    alert(
      "数式処理ライブラリを読み込めませんでした。\n" +
      "インターネット接続を確認して、ページを再読み込みしてください。"
    );
    return null;
  }

  let score = 0;
  const results = {};

  for (const id in answers) {
    const input = document.getElementById(id);
    const result = document.getElementById("r_" + id);

    const isCorrect = isCorrectAnswer(
      input.value,
      answers[id].accepted,
      id
    );

    results[id] = isCorrect;

    if (isCorrect) {
      score += answers[id].points;
      result.textContent = "○";
      result.style.color = "#16833b";
    } else {
      result.textContent = "×";
      result.style.color = "#d22";
    }
  }

  // 大問4 (1)：x と y の両方が正解した場合のみ10点（完答）
  const xCorrect = mathEquivalent(
    document.getElementById("q4_1_x").value,
    "t*cos(t)-2*sin(t)"
  );
  const yCorrect = mathEquivalent(
    document.getElementById("q4_1_y").value,
    "-t*sin(t)-2*cos(t)"
  );
  const q4_1Complete = xCorrect && yCorrect;

  results.q4_1_x = q4_1Complete;
  results.q4_1_y = q4_1Complete;

  for (const id of ["q4_1_x", "q4_1_y"]) {
    const result = document.getElementById("r_" + id);
    result.textContent = q4_1Complete ? "○" : "×";
    result.style.color = q4_1Complete ? "#16833b" : "#d22";
  }

  if (q4_1Complete) score += 10;

  document.getElementById("score").textContent =
    `得点：${score} / ${totalPoints} 点`;

  document.getElementById("topScore").textContent =
    `${score} / ${totalPoints} 点`;

  return { score, results };
}


// ==========================================
// 採点して回答を送信
// ==========================================
async function gradeAndSend() {

if (!GAS_URL || GAS_URL === "ここにGASのURL") {
  alert("GASのURLが設定されていません。");
  return;
}

  const name =
    document.getElementById("studentName").value.trim();

  if (name === "") {
    alert("氏名を入力してください。");
    return;
  }

  if (!confirm("採点して回答を送信しますか？\n送信後はスプレッドシートに記録されます。")) {
    return;
  }

  const button = document.getElementById("sendButton");

  button.disabled = true;
  button.textContent = "採点・送信中...";

  try {

    // 先に採点
    const grading = grade();

    if (grading === null) {
      return;
    }

    const score = grading.score;
    const results = grading.results;

    // 送信データ作成
    const formData = new URLSearchParams();

// すべての解答を追加
for (const id of allQuestionIds) {
  const input = document.getElementById(id);
  formData.append(id, input.value);

  if (id in results) {
    formData.append(
      id + "_result",
      results[id] ? "正解" : "不正解"
    );
  } else {
    formData.append(id + "_result", "採点対象外");
  }
}

// 基本情報
formData.append("time", new Date().toISOString());
formData.append("name", document.getElementById("name").value);
formData.append("score", score);
formData.append("total", totalPoints);
formData.append("comment", document.getElementById("comment").value);

await fetch(GAS_URL, {
  method: "POST",
  body: formData,
  mode: "no-cors"
});;

    formData.append("name", name);

    formData.append(
      "time",
      new Date().toLocaleString("ja-JP")
    );

    formData.append("score", score);
    formData.append("total", totalPoints);

    formData.append(
      "comment",
      document.getElementById("comment").value
    );

    // 各問題の解答と採点結果
    for (const id of allQuestionIds) {

      const input = document.getElementById(id);

      formData.append(id, input.value);

      if (id in results) {
        formData.append(
          id + "_result",
          results[id] ? "正解" : "不正解"
        );
      } else {
        formData.append(id + "_result", "採点対象外");
      }
    }

    // GASへ送信
    await fetch(GAS_URL, {
      method: "POST",
      body: formData,
      mode: "no-cors"
    });

    document.getElementById("sendStatus").textContent =
      "送信処理を行いました。スプレッドシートへの記録を確認してください。";

  } catch (error) {

    document.getElementById("sendStatus").textContent =
      "送信時にエラーが発生しました。通信環境やGASの設定を確認してください。";

    console.error(error);

  } finally {

    button.disabled = false;
    button.textContent = "採点して回答を送信";

  }
}


// ==========================================
// リセット
// ==========================================
function resetAll() {

  if (!confirm("入力内容と採点結果をすべて消去しますか？")) {
    return;
  }

  for (const id of allQuestionIds) {

    document.getElementById(id).value = "";

    const result = document.getElementById("r_" + id);

    if (answers[id] || id === "q4_1_x" || id === "q4_1_y") {
      result.textContent = "";
      result.style.color = "";
    }
  }

  document.getElementById("studentName").value = "";
  document.getElementById("comment").value = "";
  document.getElementById("score").textContent = "";
  document.getElementById("topScore").textContent = "";
  document.getElementById("sendStatus").textContent = "";
}

</script>

</body>
</html>
